# 学情系统 · 部署级配置（复制为 .env.production 或构建时注入）
# 三者都以 VITE_ 开头才会被打包进前端；anon key 是公开展示用的、受 RLS 约束，可安全内置。

# Supabase 项目地址，例如 https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon public key（在 Project Settings → API 里复制）
VITE_SUPABASE_ANON_KEY=

# 作用域 / 团队码：同一后端下不同团队互不覆盖；默认 main
# 例如广州学校花城组可设为 huacheng，另一位老师设为别的码即可各自独立同步
VITE_SYNC_SCOPE=main
