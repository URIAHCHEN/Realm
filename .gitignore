# dependencies
node_modules/

# build output
dist/
dist-ssr/

# local env files (密钥不入库，CI 用 Secrets 注入)
.env
.env.*
!.env.example
# 双端构建模式（无密钥，需入库保证可复现）
!.env.cloudbase

# logs / editor / OS
*.local
*.log
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

dist-deploy/

# 云函数部署包内的构建产物（由脚本从 dist 复制，不入库）
cloudfunctions/*/dist/

# 图片原图（高清大图不入库，只提交 src/assets 下的 webp）
raw-assets/

# 桌面客户端（2026-11-15）：Electron 运行时、打包产物与离线副本体积过大，不入库
desktop/node_modules/
desktop/out/
desktop/icon.iconset/
dist-desktop/
