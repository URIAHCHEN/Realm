# dependencies
node_modules/

# build output
dist/
dist-ssr/

# local env files (密钥不入库，CI 用 Secrets 注入)
.env
.env.*
!.env.example
# 双端构建模式（无密钥，需入库保证可复现）
!.env.cloudbase

# logs / editor / OS
*.local
*.log
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

dist-deploy/

# 云函数部署包内的构建产物（由脚本从 dist 复制，不入库）
cloudfunctions/*/dist/
